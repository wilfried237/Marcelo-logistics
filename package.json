{
  "name": "marcel-logistics-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "prisma generate && node scripts/check-owner-placeholders.mjs && node scripts/check-i18n.mjs",
    "build": "next build --turbopack",
    "postbuild": "node scripts/deploy-migrate.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:owner": "node scripts/check-owner-placeholders.mjs",
    "check:security": "node scripts/check-security.mjs",
    "illustrations:build": "node scripts/illustrations/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run check:security && npm test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "db:status": "prisma migrate status",
    "test:supabase": "vitest run --config vitest.supabase.config.mts",
    "test:journeys": "playwright test --config playwright.fullstack.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.541.0",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.62.0",
    "resend": "^6.35.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}

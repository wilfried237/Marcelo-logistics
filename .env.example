# Copy to .env.local for local development. Never commit real values.
# Server-only secrets must never be prefixed with NEXT_PUBLIC_.

# --- Supabase -------------------------------------------------------------
# Project URL and anon (public) key. The anon key is safe to expose to browsers;
# it is mapped to NEXT_PUBLIC_* at build time in next.config.ts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: bypasses RLS. Server-only (admin invites, private storage).
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Postgres) ----------------------------------------------------
# Pooled connection used by the running app through Prisma (Supabase transaction pooler, port 6543).
# The Vercel Supabase integration may provide POSTGRES_URL instead; it takes precedence.
DATABASE_URL=
# Session connection used ONLY for migrations (Supabase session pooler, port 5432; never db.<ref>.supabase.co).
# Production deployments migrate automatically with it (scripts/deploy-migrate.mjs). The integration's
# POSTGRES_URL_NON_POOLING takes precedence. Leave unset for Preview. See docs/ENVIRONMENT.md.
DIRECT_URL=
# Migrations refuse to run against a non-local database unless this equals the
# database host exactly. Set it only after the migration SQL has been approved.
ALLOW_MIGRATE_HOST=
# Throwaway database for `npm run db:diff` drift checks (local only, e.g. .../prisma_shadow).
SHADOW_DATABASE_URL=
# Password for the fictitious demo users created by `npm run db:seed` (local only).
SEED_USER_PASSWORD=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Name <notify@your-verified-domain>". Required to send.
EMAIL_FROM=
# Dedicated business inbox(es) for internal alerts (new requests, replies, failures), comma-separated, max 10.
# Not a personal address. Never shown to customers, returned by an API or stored in the database.
STAFF_NOTIFICATION_EMAIL=
# Signing secret of the Resend webhook (whsec_...), for delivered/bounced/complained events.
RESEND_WEBHOOK_SECRET=
# Testing only (npm run test:journeys): points the Resend SDK at a local mock. Never set in Preview/Production.
RESEND_BASE_URL=

# --- Site -----------------------------------------------------------------------
# Absolute base URL used in emails and auth redirects, e.g. https://preview.example.com
SITE_URL=http://localhost:3000

# --- Secure quote links --------------------------------------------------------------
# At least 32 random characters; signs the private quote links in customer emails.
# Use different values per environment. Rotating it invalidates every link already sent.
QUOTE_LINK_SECRET=

# --- Scheduled jobs and abuse protection ------------------------------------------
# Bearer secret for /api/cron/* (Vercel Cron sends it). At least 32 random characters;
# without it the job endpoints report CRON_DISABLED.
CRON_SECRET=
# Retention deletions also need an approved policy in config/retention.ts (owner decision L-03).
RETENTION_EXECUTION_ENABLED=false
# Salt for hashing client/email identifiers in rate-limit keys.
RATE_LIMIT_SALT=
# Development only: record emails in email_deliveries without sending them.
EMAIL_DEV_LOG=false

# --- Feature flags (all default to false; only the exact value "true" enables) ---
ENABLE_QUOTE_SUBMISSION=false
ENABLE_DEMO_DATA=false
ENABLE_PREVIEW_AREAS=false
ENABLE_TRANSACTIONAL_EMAIL=false
# Open customer registration with email verification (decision C-03). Also requires, in Supabase Auth:
# "Allow new users to sign up" ON and "Confirm email" ON (see docs/DEPLOYMENT.md).
ENABLE_CUSTOMER_REGISTRATION=false
# Requires Supabase Storage and an approved retention policy (owner decision L-03).
ENABLE_DOCUMENT_UPLOADS=false

# --- Release gate -------------------------------------------------------------------
# Set to "true" for a production release build. The build then fails if any
# {{NEEDS_OWNER}} placeholder remains. Vercel production builds are detected automatically.
RELEASE_BUILD=false
